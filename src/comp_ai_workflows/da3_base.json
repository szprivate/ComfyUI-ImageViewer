{
 "1": {
  "class_type": "LoadImage",
  "inputs": {
   "image": "example.png",
   "upload": "image"
  },
  "_meta": {
   "title": "paint:image"
  }
 },
 "2": {
  "class_type": "LoadDA3Model",
  "inputs": {
   "model_name": "depth_anything_3_base.safetensors",
   "weight_dtype": "default"
  },
  "_meta": {
   "title": "Load Depth Anything 3"
  }
 },
 "3": {
  "class_type": "DA3Inference",
  "inputs": {
   "da3_model": [
    "2",
    0
   ],
   "image": [
    "1",
    0
   ],
   "resolution": 1008,
   "resize_method": "upper_bound_resize",
   "mode": "mono"
  },
  "_meta": {
   "title": "Run Depth Anything 3"
  }
 },
 "4": {
  "class_type": "DA3Render",
  "inputs": {
   "da3_geometry": [
    "3",
    0
   ],
   "output": "depth",
   "output.normalization": "raw",
   "output.apply_sky_clip": false
  },
  "_meta": {
   "title": "Render Depth Anything 3"
  }
 },
 "5": {
  "class_type": "SaveImageAdvanced",
  "inputs": {
   "images": [
    "4",
    0
   ],
   "filename_prefix": "comp/ai/depth",
   "format": "exr",
   "format.bit_depth": "32-bit float",
   "format.input_color_space": "linear"
  },
  "_meta": {
   "title": "paint:output"
  }
 }
}
